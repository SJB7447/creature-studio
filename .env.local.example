# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# Gemini 이미지 모델명
GEMINI_FLASH_MODEL_NAME=gemini-3.1-flash-image-preview
GEMINI_PRO_MODEL_NAME=gemini-3-pro-image-preview
IMAGEN3_MODEL_NAME=imagen-3.0-generate-002

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_VERCEL_TOOLBAR_ENABLED=false

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key

# Firebase Admin SDK (마이그레이션 스크립트용)
# Firebase Console → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성
# JSON 내용을 한 줄로 압축하여 아래에 붙여넣기
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Supabase CLI (supabase link 인증용)
# https://supabase.com/dashboard/account/tokens 에서 발급
# SUPABASE_ACCESS_TOKEN=sbp_xxx...

# 관리자 설정
# 관리자 패널 접근 권한 (Google 로그인 이메일과 일치해야 함)
NEXT_PUBLIC_ADMIN_EMAIL=your-admin@gmail.com
# 관리자 크레딧 API 보호용 (Firebase UID - 로그인 후 브라우저 콘솔에서 확인)
ADMIN_UID=your-firebase-uid

# STEP 4: 토스페이먼츠 (추후 추가)
# TOSS_CLIENT_KEY=test_ck_...
# TOSS_SECRET_KEY=test_sk_...

# STEP 7: Anthropic Claude API (추후 추가)
# ANTHROPIC_API_KEY=sk-ant-...

# STEP 8: 추가 이미지 모델 (추후 추가)
# FAL_API_KEY=...
# XAI_API_KEY=...
