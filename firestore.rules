rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles: own profile writable, all readable by authenticated users
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Notifications: owner can read/update, any authenticated user can create
      match /notifications/{notifId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
      }
    }

    // Invitations: authenticated users can read/write
    match /invitations/{invitationId} {
      allow read, write: if request.auth != null;
    }

    // Projects: owner can read/write, authenticated users can read their own
    match /projects/{projectId} {
      allow read, write: if request.auth != null;

      // Episodes
      match /episodes/{episodeId} {
        allow read, write: if request.auth != null;

        // Scenes
        match /scenes/{sceneId} {
          allow read, write: if request.auth != null;
        }
      }

      // Characters
      match /characters/{characterId} {
        allow read, write: if request.auth != null;
      }

      // Confirmed Assets
      match /confirmedAssets/{assetId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
